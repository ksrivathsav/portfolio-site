# ─── Vercel Environment Variables ────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# OpenAI API key — used by api/chat.js
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Resend API key — used by api/contact.js for email delivery
# Get one at https://resend.com (free: 3,000 emails/month)
RESEND_API_KEY=re_...your-key-here...

# Email where contact form notifications are sent
CONTACT_EMAIL=srivathsavkommineni@gmail.com

# ─── Frontend (VITE_ prefix = public, bundled into client) ──
# Leave blank for Vercel (API is same origin).
# Set to your Vercel deployment URL if hosting frontend elsewhere.
VITE_API_BASE=
