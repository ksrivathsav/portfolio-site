# ─── Environment Variables ────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── AI Chatbot (FREE — no credit card needed) ──────────────
# Groq API key — used by api/chat.js (Llama 3.1, 14,400 req/day free)
# Get one FREE at https://console.groq.com  →  API Keys  →  Create
GROQ_API_KEY=gsk_...your-key-here...

# ── Contact Form (optional) ────────────────────────────────
# Resend API key — used by api/contact.js for email delivery
# Free tier: 3,000 emails/month — https://resend.com
RESEND_API_KEY=re_...your-key-here...

# Email where contact form notifications are sent
CONTACT_EMAIL=srivathsavkommineni@gmail.com

# ── Frontend (VITE_ prefix = public, bundled into client) ──
# Leave blank for Vercel (API is same origin).
# Set to your Vercel deployment URL if hosting frontend elsewhere.
VITE_API_BASE=
